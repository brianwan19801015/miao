<!-- Top Bar -->
<div class="top-bar">
  <div class="container">
    <div class="top-bar-left">{{ 'general.brand' | t }} · {{ 'general.hero_slogan' | t }}</div>
    <div class="top-bar-right">
      <a href="#contact">{{ 'general.contact_us' | t }}</a>
      <span class="sep">|</span>
      <span>{{ 'general.herbal_care' | t }}</span>
    </div>
  </div>
</div>

<header class="header" id="top">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="{{ 'slide1_img2_1.png' | asset_url }}" alt="{{ 'general.brand' | t }}" loading="lazy">
      <span>{{ 'general.brand' | t }}</span>
    </a>
    <nav class="nav">
      <a href="/">{{ 'general.home' | t }}</a>
      <a href="/#product">{{ 'general.product' | t }}</a>
      <a href="/#technology">{{ 'general.technology' | t }}</a>
      <a href="/#effects">{{ 'general.effects' | t }}</a>
      <a href="/blogs/news">{{ 'footer.link_blog' | t }}</a>
      <a href="/pages/feedback">{{ 'general.trial_feedback' | t }}</a>
      <a href="/#contact">{{ 'general.consult' | t }}</a>
    </nav>
    <a href="#contact" class="btn btn-primary">{{ 'general.consult_now' | t }}</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
