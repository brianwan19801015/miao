<section class="blog-article">
  <div class="container" style="max-width:780px; margin:0 auto; padding:80px 20px 60px;">

    <!-- Breadcrumb -->
    <nav class="article-breadcrumb" style="margin-bottom:24px; font-size:14px; color:var(--text-secondary);" aria-label="Breadcrumb">
      <a href="/" style="color:var(--brand); text-decoration:none;">{{ 'general.home' | t | default: 'Home' }}</a>
      <span style="margin:0 8px;">/</span>
      <a href="/blogs/news" style="color:var(--brand); text-decoration:none;">Blog</a>
      <span style="margin:0 8px;">/</span>
      <span>{{ article.title }}</span>
    </nav>

    <!-- Article Header -->
    <header class="article-header" style="margin-bottom:32px;">
      <h1 style="font-size:clamp(24px,4vw,36px); font-weight:800; line-height:1.3; margin-bottom:12px; color:var(--text);">
        {{ article.title }}
      </h1>
      <div class="article-meta" style="display:flex; flex-wrap:wrap; gap:16px; font-size:14px; color:var(--text-muted); margin-bottom:20px;">
        {% if article.author %}
        <span><i class="fas fa-user-edit"></i> By {{ article.author }}</span>
        {% endif %}
        <span><i class="far fa-calendar-alt"></i> {{ article.published_at | date: "%B %d, %Y" }}</span>
        <span><i class="far fa-clock"></i> {{ article.content | reading_time }} min read</span>
        <span><i class="fas fa-sync-alt"></i> Updated: {{ article.updated_at | date: "%B %d, %Y" }}</span>
      </div>
      {% if article.excerpt != blank %}
      <div class="article-excerpt" style="font-size:18px; color:var(--text-secondary); line-height:1.8; padding:20px 24px; background:var(--bg-warm); border-left:4px solid var(--brand); border-radius:0 var(--radius-sm) var(--radius-sm) 0; margin-bottom:24px;">
        {{ article.excerpt }}
      </div>
      {% endif %}
      {% if article.image %}
      <img src="{{ article.image | img_url: '1200x' }}" alt="{{ article.title }}" style="width:100%; border-radius:var(--radius-md); margin-bottom:32px;" loading="eager">
      {% endif %}
    </header>

    <!-- Article Content -->
    <div class="article-body" style="font-size:17px; line-height:2; color:var(--text);">
      {{ article.content }}
    </div>

    <!-- Author Bio (E-E-A-T signal) -->
    {% if article.author %}
    <div class="author-box" style="background:var(--bg); border:1px solid var(--line-light); border-radius:var(--radius-md); padding:24px; margin:40px 0; display:flex; gap:16px; align-items:center;">
      <div style="flex-shrink:0; width:56px; height:56px; background:var(--brand-subtle); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:700; color:var(--brand);">
        {{ article.author | slice: 0, 1 | upcase }}
      </div>
      <div>
        <div style="font-weight:600; margin-bottom:4px;">{{ article.author }}</div>
        <div style="font-size:14px; color:var(--text-secondary);">Herbal Care Specialist at Miao Ben Fang</div>
      </div>
    </div>
    {% endif %}

    <!-- Share -->
    <div style="border-top:1px solid var(--line-light); padding-top:24px; margin:32px 0; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <span style="font-size:14px; color:var(--text-secondary);">Share:</span>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener" style="color:var(--brand); font-size:20px;"><i class="fab fa-facebook"></i></a>
      <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" style="color:var(--brand); font-size:20px;"><i class="fab fa-x-twitter"></i></a>
      <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ shop.url }}{{ article.url }}&title={{ article.title | url_encode }}" target="_blank" rel="noopener" style="color:var(--brand); font-size:20px;"><i class="fab fa-linkedin"></i></a>
      <a href="https://api.whatsapp.com/send?text={{ article.title | url_encode }}%20{{ shop.url }}{{ article.url }}" target="_blank" rel="noopener" style="color:var(--brand); font-size:20px;"><i class="fab fa-whatsapp"></i></a>
    </div>

    <!-- Back to Blog -->
    <div style="text-align:center; margin-top:40px;">
      <a href="/blogs/news" style="display:inline-block; padding:12px 32px; border:2px solid var(--brand); border-radius:var(--radius-full); color:var(--brand); font-weight:600; text-decoration:none;">
        ← Back to Blog
      </a>
    </div>

  </div>
</section>

<!-- JSON-LD: Article Schema (AI SEO) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ article.title }}",
  "description": "{% if article.excerpt != blank %}{{ article.excerpt | strip_html | truncate: 160 }}{% else %}{{ article.content | strip_html | truncate: 160 }}{% endif %}",
  "image": "{% if article.image %}{{ article.image | img_url: '1200x' }}{% endif %}",
  "author": {
    "@type": "Person",
    "name": "{% if article.author != blank %}{{ article.author }}{% else %}Miao Ben Fang{% endif %}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "苗本芳",
    "logo": { "@type": "ImageObject", "url": "{{ 'slide1_img2_1.png' | asset_url }}" }
  },
  "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%d' }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ shop.url }}{{ article.url }}" }
}
</script>

<!-- JSON-LD: BreadcrumbList -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ shop.url }}/blogs/news" },
    { "@type": "ListItem", "position": 3, "name": "{{ article.title }}", "item": "{{ shop.url }}{{ article.url }}" }
  ]
}
</script>

{% schema %}
{
  "name": "Blog Article",
  "settings": [],
  "presets": [{ "name": "Blog Article" }]
}
{% endschema %}
