<section class="brand-story" id="brand">
  <div class="container story-grid">
    <div class="story-image">
      <img src="{{ 'craft-scene.png' | asset_url }}" alt="{{ 'brand_story.alt' | t }}" loading="lazy">
    </div>
    <div class="story-text">
      <span class="badge">{{ 'brand_story.title' | t }}</span>
      <h2>{{ 'brand_story.subtitle' | t }}</h2>
      <p>{{ 'brand_story.desc' | t | newline_to_br }}</p>
      <ul class="story-points">
        <li><i class="fas fa-leaf"></i>{{ 'brand_story.item1' | t }}</li>
        <li><i class="fas fa-snowflake"></i>{{ 'brand_story.item2' | t }}</li>
        <li><i class="fas fa-ban"></i>{{ 'brand_story.item3' | t }}</li>
      </ul>
      <a href="#ingredients" class="btn btn-outline">{{ 'brand_story.explore' | t }}</a>
    </div>
  </div>
</section>
{% schema %}{"name":"Brand Story","settings":[],"presets":[{"name":"Brand Story"}]}{% endschema %}
