  align-items: center;
  max-width: 1100px;
  margin: 0 auto;
}
.story-image img {
  width: 100%;
  border-radius: 24px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.08);
}
.story-text .badge { margin-bottom: 12px; }
