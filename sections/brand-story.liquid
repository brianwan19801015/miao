<section class="brand-story" id="brand">
  <div class="container story-grid">
    <div class="story-image">
      <img src="{{ 'slide3_img1_8.png' | asset_url }}" alt="{{ 'brand_story.alt' | t }}" loading="lazy">
    </div>
    <div class="story-text">
      <span class="badge">{{ 'brand_story.title' | t }}</span>
      <h2>{{ 'brand_story.subtitle' | t }}</h2>
      <p>{{ 'product_intro.heritage_desc' | t }}</p>
      <ul class="story-points">
        <li><i class="fas fa-leaf"></i>{{ 'product_intro.heritage_item1' | t }}</li>
        <li><i class="fas fa-snowflake"></i>{{ 'product_intro.heritage_item2' | t }}</li>
        <li><i class="fas fa-ban"></i>{{ 'product_intro.heritage_item3' | t }}</li>
      </ul>
      <a href="#ingredients" class="btn btn-outline">{{ 'product_intro.explore_link' | t }}</a>
    </div>
  </div>
</section>
{% schema %}{"name":"Brand Story","settings":[],"presets":[{"name":"Brand Story"}]}{% endschema %}
