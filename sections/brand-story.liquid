  font-size: 15px;
  color: #555;
  line-height: 1.8;
  margin: 0 0 20px;
}
.story-points {
  list-style: none;
  padding: 0;
  margin: 0 0 24px;
}
.story-points li {
  padding: 10px 0;
  font-size: 15px;
  color: #333;
  border-bottom: 1px solid #e8f0e0;
}
.story-points li:last-child { border-bottom: none; }
.story-points i {
  color: #4a7c3f;
  margin-right: 10px;
  width: 20px;
}
@media (max-width: 768px) {
