<section class="how-to-use" id="how-to-use">
  <div class="container">
    <h2 class="section-title">{{ 'how_to_use.title' | t }}</h2>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-img"><img src="{{ 'slide9_img7_30.png' | asset_url }}" alt="起泡" loading="lazy"></div>
        <div class="step-number">01</div>
        <h3>搓泡</h3>
        <p>{{ 'how_to_use.step1_desc' | t }}</p>
      </div>
      <div class="step-card">
        <div class="step-img"><img src="{{ 'slide9_img8_31.png' | asset_url }}" alt="按摩" loading="lazy"></div>
        <div class="step-number">02</div>
        <h3>按摩</h3>
        <p>{{ 'how_to_use.step2_desc' | t }}</p>
      </div>
      <div class="step-card">
        <div class="step-img"><img src="{{ 'slide9_img9_32.png' | asset_url }}" alt="冲洗" loading="lazy"></div>
        <div class="step-number">03</div>
        <h3>冲净</h3>
        <p>{{ 'how_to_use.step3_desc' | t }}</p>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"How To Use","settings":[],"presets":[{"name":"How To Use"}]}{% endschema %}
