<section class="technology" id="technology">
  <div class="container">
    <h2 class="section-title">{{ 'technology.title' | t }}</h2>
    
    <div class="tech-compare">
      <div class="compare-card compare-old">
        <span class="badge badge-danger">{{ 'technology.hot_title' | t }}</span>
        <h3>{{ 'technology.hot_subtitle' | t }}</h3>
        <div class="compare-icon">🔥</div>
        <p>{{ 'technology.hot_desc' | t }}</p>
      </div>
      <div class="compare-vs">VS</div>
      <div class="compare-card compare-new">
        <span class="badge">CORE TECHNOLOGY 01</span>
        <h3>{{ 'technology.cold_title' | t }}</h3>
        <p class="tech-highlight">{{ 'technology.cold_subtitle' | t }}</p>
        
        <div class="tech-stats">
          <div class="tech-stat">
            <span class="tech-stat-value">&lt;40℃</span>
            <span class="tech-stat-label">{{ 'technology.cold_item1' | t }}</span>
          </div>
          <div class="tech-stat">
            <span class="tech-stat-value">0</span>
            <span class="tech-stat-label">{{ 'technology.cold_label1' | t }}</span>
          </div>
          <div class="tech-stat">
            <span class="tech-stat-value">45天</span>
            <span class="tech-stat-label">{{ 'technology.cold_label2' | t }}</span>
          </div>
        </div>
        
        <p class="tech-desc">{{ 'technology.cold_desc' | t }}</p>
      </div>
    </div>
    
    <div class="zero-add-section">
      <div class="zero-add-header">
        <span class="badge">CORE TECHNOLOGY 02</span>
        <h3>{{ 'technology.zero_title' | t }}</h3>
        <p class="zero-add-sub">{{ 'technology.zero_desc' | t }}</p>
      </div>
      
      <div class="zero-add-grid">
        <div class="zero-add-item">
          <div class="zero-add-icon">🚫</div>
          <h4>0 硅油</h4>
          <p>{{ 'technology.zero_item1_desc' | t }}</p>
        </div>
        <div class="zero-add-item">
          <div class="zero-add-icon">🚫</div>
          <h4>0 月桂醇</h4>
          <p>{{ 'technology.zero_item2_desc' | t }}</p>
        </div>
        <div class="zero-add-item">
          <div class="zero-add-icon">🚫</div>
          <h4>0 防腐剂</h4>
          <p>{{ 'technology.zero_item3_desc' | t }}</p>
        </div>
        <div class="zero-add-item">
          <div class="zero-add-icon">🚫</div>
          <h4>0 硫酸盐</h4>
          <p>{{ 'technology.zero_item4_desc' | t }}</p>
        </div>
        <div class="zero-add-item">
          <div class="zero-add-icon">🚫</div>
          <h4>0 人工香精</h4>
          <p>{{ 'technology.zero_item5_desc' | t }}</p>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Technology","settings":[],"presets":[{"name":"Technology"}]}{% endschema %}
