<section class="core-advantages" id="core-advantages" style="background: url('{{ 'slide7_img0_27.png' | asset_url }}') center/cover no-repeat;">
  <div class="container">
    <h2 class="section-title">{{ 'technology.title' | t }}</h2>
    <div class="advantages-grid">
      <div class="advantage-card">
        <h3>{{ 'core_advantages.item1_icon_title' | t }}</h3>
        <p>{{ 'core_advantages.item1_desc' | t }}</p>
      </div>
      <div class="advantage-card">
        <h3>{{ 'core_advantages.item2_icon_title' | t }}</h3>
        <p>{{ 'core_advantages.item2_desc_full' | t }}</p>
      </div>
      <div class="advantage-card">
        <h3>{{ 'core_advantages.item3_icon_title' | t }}</h3>
        <p>{{ 'core_advantages.item3_desc' | t }}</p>
      </div>
    </div>
  </div>
</section>
