<section class="effects-cert" id="effects">
  <div class="container">
    <!-- 认证头部 -->
    <div class="cert-badge">
      <span class="cert-badge-label">权威检测认证</span>
      <span class="cert-badge-date">广东欣研检测 · 2026年04月07日 · 四维功效验证</span>
    </div>

    <!-- 标题 -->
    <h2 class="section-title center">四大核心功效一步到位</h2>
    <p class="section-desc center">精准解决头皮困扰：深层控油平衡水油、植物配方去屑、舒缓头皮止痒、滋养发根固发。</p>

    <!-- 功效卡片（含认证报告编号） -->
    <div class="effects-cert-grid">
      <div class="effect-cert-card">
        <div class="effect-cert-badge">🧴 去屑功效</div>
        <div class="effect-img"><img src="{{ 'slide12_img3_39.jpg' | asset_url }}" alt="净屑清爽" loading="lazy"></div>
        <h3>净屑清爽</h3>
        <p>帮助减少可见头屑与附着感。</p>
        <div class="effect-report">报告编号：XYJCR260328-108</div>
      </div>
      <div class="effect-cert-card">
        <div class="effect-cert-badge">💧 控油功效</div>
        <div class="effect-img"><img src="{{ 'slide12_img2_38.jpg' | asset_url }}" alt="平衡控油" loading="lazy"></div>
        <h3>平衡控油</h3>
        <p>减少头皮油腻感，发根更蓬松。</p>
        <div class="effect-report">报告编号：XYJCR260328-109</div>
      </div>
      <div class="effect-cert-card">
        <div class="effect-cert-badge">🌿 滋养功效</div>
        <div class="effect-img"><img src="{{ 'slide12_img4_40.jpg' | asset_url }}" alt="舒缓止痒" loading="lazy"></div>
        <h3>舒缓止痒</h3>
        <p>减轻头皮紧绷与瘙痒不适。</p>
        <div class="effect-report">报告编号：XYJCR260328-110</div>
      </div>
      <div class="effect-cert-card">
        <div class="effect-cert-badge">🛡️ 防断发功效</div>
        <div class="effect-img"><img src="{{ 'slide12_img5_41.jpg' | asset_url }}" alt="强韧固发" loading="lazy"></div>
        <h3>强韧固发</h3>
        <p>改善发丝脆弱，降低断裂与拉扯损伤。</p>
        <div class="effect-report">报告编号：XYJCR260328-111</div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Effects & Certification",
  "settings": [],
  "presets": [{ "name": "Effects & Certification" }]
}
{% endschema %}
