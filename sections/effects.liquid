<section class="effects-cert" id="effects">
  <div class="container">
    <!-- 认证头部 -->
    <div class="cert-badge">
      <span class="cert-badge-label">{{ 'effects.cert_badge' | t }}</span>
      <span class="cert-badge-date">{{ 'effects.cert_info' | t }}</span>
    </div>

    <!-- 标题 -->
    <h2 class="section-title center">{{ 'why_us.effects_title' | t }}</h2>
    <p class="section-desc center">{{ 'why_us.effects_desc' | t }}</p>

    <!-- 功效卡片（含认证报告编号） -->
    <div class="effects-cert-grid">
      <div class="effect-cert-card">
        <div class="effect-cert-badge">{{ 'effects.item1_icon_label' | t }}</div>
        <div class="effect-img"><img src="{{ 'slide12_img3_39.jpg' | asset_url }}" alt="{{ 'effects.item1_title' | t }}" loading="lazy"></div>
        <h3>{{ 'effects.item1_title' | t }}</h3>
        <p>{{ 'effects.item1_desc' | t }}</p>
        <div class="effect-report">{{ 'effects.item1_report' | t }}</div>
      </div>
      <div class="effect-cert-card">
        <div class="effect-cert-badge">{{ 'effects.item2_icon_label' | t }}</div>
        <div class="effect-img"><img src="{{ 'slide12_img2_38.jpg' | asset_url }}" alt="{{ 'effects.item2_title' | t }}" loading="lazy"></div>
        <h3>{{ 'effects.item2_title' | t }}</h3>
        <p>{{ 'effects.item2_desc' | t }}</p>
        <div class="effect-report">{{ 'effects.item2_report' | t }}</div>
      </div>
      <div class="effect-cert-card">
        <div class="effect-cert-badge">{{ 'effects.item3_icon_label' | t }}</div>
        <div class="effect-img"><img src="{{ 'slide12_img4_40.jpg' | asset_url }}" alt="{{ 'effects.item3_title' | t }}" loading="lazy"></div>
        <h3>{{ 'effects.item3_title' | t }}</h3>
        <p>{{ 'effects.item3_desc' | t }}</p>
        <div class="effect-report">{{ 'effects.item3_report' | t }}</div>
      </div>
      <div class="effect-cert-card">
        <div class="effect-cert-badge">{{ 'effects.item4_icon_label' | t }}</div>
        <div class="effect-img"><img src="{{ 'slide12_img5_41.jpg' | asset_url }}" alt="{{ 'effects.item4_title' | t }}" loading="lazy"></div>
        <h3>{{ 'effects.item4_title' | t }}</h3>
        <p>{{ 'effects.item4_desc' | t }}</p>
        <div class="effect-report">{{ 'effects.item4_report' | t }}</div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Effects & Certification",
  "settings": [],
  "presets": [{ "name": "Effects & Certification" }]
}
{% endschema %}
