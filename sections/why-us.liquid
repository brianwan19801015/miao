<section class="why-us" id="why-us">
  <div class="container">
    <h2 class="section-title center">{{ 'why_us.title' | t }}</h2>
    <p class="section-desc center">{{ 'why_us.subtitle' | t }}</p>
    
    <div class="why-grid">
      <div class="why-card animate-on-scroll">
        <div class="why-icon">🌿</div>
        <h3>{{ 'why_us.adv1_title' | t }}</h3>
        <p>{{ 'why_us.adv1_desc' | t }}</p>
      </div>

      <div class="why-card animate-on-scroll">
        <div class="why-icon">⏳</div>
        <h3>{{ 'why_us.adv2_title' | t }}</h3>
        <p>{{ 'why_us.adv2_desc' | t }}</p>
      </div>

      <div class="why-card animate-on-scroll">
        <div class="why-icon">✅</div>
        <h3>{{ 'why_us.adv3_title' | t }}</h3>
        <p>{{ 'why_us.adv3_desc' | t }}</p>
      </div>
    </div>

    <div class="why-bottom">
      <div class="why-bottom-item">
        <h4>{{ 'why_us.effects_title' | t }}</h4>
        <p>{{ 'why_us.effects_desc' | t }}</p>
      </div>
      <div class="why-bottom-item">
        <h4>{{ 'why_us.welfare_title' | t }}</h4>
        <p>{{ 'why_us.welfare_desc' | t }}</p>
        <a href="#contact" class="btn btn-primary" style="margin-top:12px;">{{ 'general.consult_now' | t }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Why Us","settings":[],"presets":[{"name":"Why Us"}]}{% endschema %}
