<footer class="footer">
  <div class="container footer-inner">
    <div>
      <strong>{{ 'general.brand' | t }}</strong>
      <p>{{ 'general.brand_subtitle' | t }}</p>
    </div>
    <div class="footer-links">
      <a href="/">{{ 'general.home' | t }}</a>
      <a href="/#product">{{ 'footer.link_product' | t }}</a>
      <a href="/#contact">{{ 'footer.link_contact' | t }}</a>
      <a href="/pages/privacy-policy">{{ 'footer.link_privacy' | t }}</a>
      <a href="/pages/legal-notice">{{ 'footer.link_legal' | t }}</a>
      <a href="/pages/shipping-returns">{{ 'footer.link_shipping' | t }}</a>
    </div>
  </div>
  <div class="footer-bottom" style="text-align:center; padding-top:20px; border-top:1px solid rgba(255,255,255,0.1); margin-top:20px; font-size:13px; color:rgba(255,255,255,0.5);">
    <p>&copy; 2026 {{ 'general.brand' | t }}. {{ 'footer.rights' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
