<footer class="footer">
  <div class="container footer-inner">
    <div>
      <strong>{{ 'general.brand' | t }}</strong>
      <p>{{ 'general.brand_subtitle' | t }}</p>
    </div>
    <div class="footer-links">
      <a href="/">{{ 'general.home' | t }}</a>
      <a href="/#product">{{ 'footer.link_product' | t }}</a>
      <a href="/#contact">{{ 'footer.link_contact' | t }}</a>
    </div>
  </div>
</footer>

