<section class="faq" id="faq">
  <div class="container">
    <h2 class="section-title">{{ 'faq.title' | t }}</h2>
    <div class="faq-list">
      <div class="faq-item">
        <div class="faq-question" onclick="this.parentElement.classList.toggle('active')">{{ 'faq.q1' | t }}<span class="faq-toggle"><i class="fas fa-chevron-down"></i></span>
        </div>
        <div class="faq-answer">{{ 'faq.a1' | t }}</div>
      </div>
      <div class="faq-item">
        <div class="faq-question" onclick="this.parentElement.classList.toggle('active')">{{ 'faq.q2' | t }}<span class="faq-toggle"><i class="fas fa-chevron-down"></i></span>
        </div>
        <div class="faq-answer">{{ 'faq.a2' | t }}</div>
      </div>
      <div class="faq-item">
        <div class="faq-question" onclick="this.parentElement.classList.toggle('active')">{{ 'faq.q3' | t }}<span class="faq-toggle"><i class="fas fa-chevron-down"></i></span>
        </div>
        <div class="faq-answer">{{ 'faq.a3' | t }}</div>
      </div>
      <div class="faq-item">
        <div class="faq-question" onclick="this.parentElement.classList.toggle('active')">{{ 'faq.q4' | t }}<span class="faq-toggle"><i class="fas fa-chevron-down"></i></span>
        </div>
        <div class="faq-answer">{{ 'faq.a4' | t }}</div>
      </div>
      <div class="faq-item">
        <div class="faq-question" onclick="this.parentElement.classList.toggle('active')">{{ 'faq.q5' | t }}<span class="faq-toggle"><i class="fas fa-chevron-down"></i></span>
        </div>
        <div class="faq-answer">{{ 'faq.a5' | t }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}