<section class="contact" id="contact">
  <div class="container contact-wrap">
    <div class="contact-info">
      <h2 class="section-title">{{ 'contact.title' | t }}</h2>
      <p class="section-desc">{{ 'contact.desc' | t }}</p>
      <ul class="contact-list">
        <li><i class="fas fa-phone"></i>{{ 'contact.phone_label' | t }}<span class="contact-val">13926143113</span></li>
        <li><i class="fas fa-comment-dots"></i>{{ 'contact.wechat_label' | t }}<span class="contact-val">miaobenfang</span></li>
        <li><i class="fas fa-envelope"></i>{{ 'contact.email_label' | t }}<span class="contact-val">service@miaobenfang.com</span></li>
      </ul>
    </div>
    <div class="contact-card contact-form-wrap">
      <h3>{{ 'contact.form_title' | t }}</h3>
      <p>{{ 'contact.form_desc' | t }}</p>

      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="form-success" style="background:#f0fff4; border:1px solid #48bb78; color:#22543d; padding:16px; border-radius:8px; margin-bottom:16px;">
            &#10003; {{ 'contact.form_success' | t }}
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="form-errors" style="background:#fff5f5; border:1px solid #fc8181; color:#c53030; padding:16px; border-radius:8px; margin-bottom:16px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <input type="text" name="contact[name]" placeholder="{{ 'contact.name_placeholder' | t }}" required
          value="{% if form.name %}{{ form.name }}{% endif %}">
        <input type="text" name="contact[phone]" placeholder="{{ 'contact.phone_placeholder' | t }}" required
          value="{% if form.phone %}{{ form.phone }}{% endif %}">
        <select name="contact[concern]">
          <option value="">{{ 'contact.form_placeholder' | t }}</option>
          <option value="Oily Scalp" {% if form.concern == 'Oily Scalp' %}selected{% endif %}>{{ 'pain_points.item1_title' | t }}</option>
          <option value="Dandruff" {% if form.concern == 'Dandruff' %}selected{% endif %}>{{ 'pain_points.item2_title' | t }}</option>
          <option value="Itching" {% if form.concern == 'Itching' %}selected{% endif %}>{{ 'pain_points.item3_title' | t }}</option>
          <option value="Hair Loss" {% if form.concern == 'Hair Loss' %}selected{% endif %}>{{ 'pain_points.item4_title' | t }}</option>
          <option value="Other" {% if form.concern == 'Other' %}selected{% endif %}>{{ 'contact.other_label' | t }}</option>
        </select>
        <textarea name="contact[body]" rows="3" placeholder="{{ 'contact.message_placeholder' | t }}" style="width:100%; padding:12px 16px; border:1px solid var(--line); border-radius:8px; font-size:14px; font-family:inherit; resize:vertical; margin-bottom:12px;">{% if form.body %}{{ form.body }}{% endif %}</textarea>
        <button type="submit" class="btn btn-primary btn-block">{{ 'contact.form_submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
