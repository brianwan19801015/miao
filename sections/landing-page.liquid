<section class="landing-page">
  <div class="landing-hero" style="background:linear-gradient(135deg, var(--brand-dark), var(--brand)); color:#fff; padding:100px 20px 60px; text-align:center; border-radius:0 0 var(--radius-xl) var(--radius-xl);">
    <div class="container" style="max-width:800px; margin:0 auto;">
      <h1 style="font-size:clamp(28px,5vw,48px); font-weight:700; margin-bottom:20px; color:#fff;">{{ page.title }}</h1>
      {% if page.metafields.custom.subtitle %}
        <p style="font-size:20px; opacity:0.9; margin-bottom:32px;">{{ page.metafields.custom.subtitle }}</p>
      {% endif %}
      <a href="#contact" style="display:inline-block; background:var(--accent); color:#fff; padding:16px 48px; border-radius:var(--radius-full); font-size:18px; font-weight:700; text-decoration:none;">
        {{ 'general.consult_now' | t }}
      </a>
    </div>
  </div>

  <div class="container" style="max-width:800px; margin:0 auto; padding:60px 20px;">
    <div class="landing-content" style="font-size:16px; line-height:2; color:var(--text);">
      {{ page.content }}
    </div>
  </div>

  <div class="container" style="max-width:900px; margin:0 auto; padding:0 20px 60px;">
    <div class="landing-features" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:24px;">
      <div class="landing-card" style="background:var(--card); border-radius:var(--radius-md); padding:32px; text-align:center; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <div style="font-size:40px; margin-bottom:16px;">🌿</div>
        <h3 style="font-size:18px; margin-bottom:8px; color:var(--brand-dark);">18 Miao Herbs</h3>
        <p style="font-size:14px; color:var(--text-secondary);">Science-based formula from ancient Miao wisdom.</p>
      </div>
      <div class="landing-card" style="background:var(--card); border-radius:var(--radius-md); padding:32px; text-align:center; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <div style="font-size:40px; margin-bottom:16px;">⏳</div>
        <h3 style="font-size:18px; margin-bottom:8px; color:var(--brand-dark);">45-Day Cold Process</h3>
        <p style="font-size:14px; color:var(--text-secondary);">Maximum potency preserved through low-temp saponification.</p>
      </div>
      <div class="landing-card" style="background:var(--card); border-radius:var(--radius-md); padding:32px; text-align:center; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
        <div style="font-size:40px; margin-bottom:16px;">✅</div>
        <h3 style="font-size:18px; margin-bottom:8px; color:var(--brand-dark);">5 Zero-Additives</h3>
        <p style="font-size:14px; color:var(--text-secondary);">No silicone, SLS, preservatives, sulfates, or artificial fragrance.</p>
      </div>
    </div>
  </div>

  <div style="background:var(--bg-warm); padding:60px 20px; text-align:center;">
    <div class="container" style="max-width:600px; margin:0 auto;">
      <h2 style="font-size:28px; margin-bottom:12px; color:var(--text);">{{ 'general.hero_slogan' | t }}</h2>
      <p style="font-size:16px; color:var(--text-secondary); margin-bottom:32px;">{{ 'general.hero_desc' | t }}</p>
      <a href="#contact" style="display:inline-block; background:var(--brand); color:#fff; padding:18px 56px; border-radius:var(--radius-full); font-size:20px; font-weight:700; text-decoration:none;">
        {{ 'general.consult_now' | t }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Page",
  "settings": [],
  "presets": [{ "name": "Landing Page" }]
}
{% endschema %}
