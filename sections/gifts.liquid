<section class="gifts" id="gifts" style="background: linear-gradient(135deg, #2d4a2a 0%, #4a7c3f 50%, #2d4a2a 100%);">
  <div class="container">
    <h2 class="section-title" style="color:#fff;">新人专属超值福利</h2>
    <p class="section-desc" style="color:rgba(255,255,255,0.9);">限时活动价格美丽，下单即享多重赠品</p>
    <div class="gifts-showcase">
      <div class="gifts-image">
        <img src="{{ 'slide10_img0_33.png' | asset_url }}" alt="苗本芳养发皂赠品">
        <div class="gifts-icons">
          <div class="gift-icon-item">
            <img src="{{ 'slide11_img9_35.png' | asset_url }}" alt="草本植萃">
            <span>草本植萃</span>
          </div>
          <div class="gift-icon-item">
            <img src="{{ 'slide11_img10_36.png' | asset_url }}" alt="温和养护">
            <span>温和养护</span>
          </div>
        </div>
      </div>
      <div class="gifts-content">
        <div class="gift-badge">买就送</div>
        <h3 style="color:#fff;">赠品价值超百元！</h3>
        <ul class="gift-list">
          <li><i class="fas fa-gift"></i> 草本养发体验装</li>
          <li><i class="fas fa-gift"></i> 配套起泡网</li>
          <li><i class="fas fa-gift"></i> 使用指南手册</li>
        </ul>
        <p class="gifts-cta" style="color:rgba(255,255,255,0.8);">立即咨询，获取专属优惠</p>
        <a href="#contact" class="btn btn-primary">立即咨询</a>
      </div>
    </div>
  </div>
</section>

<style>
.gifts { padding: 100px 0; position: relative; }
.gifts .container { position: relative; z-index: 1; }
.gifts-showcase {
  display: flex;
  align-items: center;
  gap: 48px;
  margin-top: 40px;
  max-width: 960px;
  margin-left: auto;
  margin-right: auto;
}
.gifts-image { flex: 1; position: relative; }
.gifts-image > img { width: 100%; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.3); display: block; }
.gifts-icons {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-top: 16px;
}
.gift-icon-item {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(8px);
  padding: 8px 16px;
  border-radius: 24px;
  color: #fff;
  font-size: 13px;
  font-weight: 500;
}
.gift-icon-item img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
.gifts-content { flex: 1; }
.gift-badge {
  display: inline-block;
  background: #e85d3a;
  color: white;
  padding: 6px 20px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 16px;
  animation: pulse-badge 2s ease-in-out infinite;
}
@keyframes pulse-badge {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}
.gift-list { list-style: none; padding: 0; margin-bottom: 24px; }
.gift-list li { padding: 10px 0; font-size: 16px; color: rgba(255,255,255,0.9); }
.gift-list li i { color: #e85d3a; margin-right: 12px; }
.gifts-cta { font-size: 14px; margin-bottom: 16px; }
@media (max-width: 768px) { 
  .gifts-showcase { flex-direction: column; } 
  .gifts-icons { flex-wrap: wrap; }
}
</style>

{% schema %}
{
  "name": "Gifts",
  "settings": [],
  "presets": [{ "name": "Gifts" }]
}
{% endschema %}
