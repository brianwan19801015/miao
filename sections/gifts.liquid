<section class="gifts" id="gifts">
  <div class="container">
    <h2 class="section-title center" style="color:#fff;">{{ 'gifts.title' | t }}</h2>
    <p class="section-desc center" style="color:rgba(255,255,255,0.8);">{{ 'gifts.subtitle' | t }}</p>
    
    <div class="gift-grid">
      <!-- 起泡网（每盒） -->
      <div class="gift-card animate-on-scroll">
        <div class="gift-img">
          <img src="{{ 'slide10_gift_bubble_net.png' | asset_url }}" alt="{{ 'gifts.item1_name' | t }}" loading="lazy">
        </div>
        <h3 class="gift-name">{{ 'gifts.item1_name' | t }}<span class="gift-condition">{{ 'gifts.item1_tier' | t }}</span></h3>
        <p class="gift-desc">{{ 'gifts.item1_desc' | t }}</p>
      </div>

      <!-- 沥水皂盒（购买两盒赠送） -->
      <div class="gift-card animate-on-scroll">
        <div class="gift-img">
          <img src="{{ 'slide10_gift_drain_box.png' | asset_url }}" alt="{{ 'gifts.item2_name' | t }}" loading="lazy">
        </div>
        <h3 class="gift-name">{{ 'gifts.item2_name' | t }}<span class="gift-condition">{{ 'gifts.item2_tier' | t }}</span></h3>
        <p class="gift-desc">{{ 'gifts.item2_desc' | t }}</p>
      </div>

      <!-- 气垫按摩梳（购买三盒赠送价值） -->
      <div class="gift-card animate-on-scroll">
        <div class="gift-img">
          <img src="{{ 'slide10_gift_air_cushion_comb.png' | asset_url }}" alt="{{ 'gifts.item3_name' | t }}" loading="lazy">
        </div>
        <h3 class="gift-name">{{ 'gifts.item3_name' | t }}<span class="gift-condition">{{ 'gifts.item3_tier' | t }}</span></h3>
        <p class="gift-desc">{{ 'gifts.item3_desc' | t }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gifts",
  "settings": [],
  "presets": [{ "name": "Gifts" }]
}
{% endschema %}
