<section class="ingredients" id="ingredients">
  <div class="container">
    <h2 class="section-title center">{{ 'ingredients.title' | t }}</h2>
    <p class="section-desc center">{{ 'ingredients.desc' | t }}</p>
    
    <div class="herb-categories">
      <!-- 养发根基 -->
      <div class="herb-category animate-on-scroll">
        <div class="herb-img"><img src="{{ 'slide4_img11_14.png' | asset_url }}" alt="{{ 'ingredients.group1_name' | t }}" loading="lazy"></div>
        <h3 class="category-title">{{ 'ingredients.group1_icon_title' | t }}</h3>
        <div class="herb-tags">
          <span class="herb-tag">{{ 'ingredients.herb_goutouwu' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_sangshen' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_mohanlian' | t }}</span>
        </div>
      </div>

      <!-- 控油净澈 -->
      <div class="herb-category animate-on-scroll">
        <div class="herb-img"><img src="{{ 'slide4_img12_15.png' | asset_url }}" alt="{{ 'ingredients.group2_name' | t }}" loading="lazy"></div>
        <h3 class="category-title">{{ 'ingredients.group2_icon_title' | t }}</h3>
        <div class="herb-tags">
          <span class="herb-tag">{{ 'ingredients.herb_zaojiao' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_wuhuanzi' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_cebaiye' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_chaku' | t }}</span>
        </div>
      </div>

      <!-- 舒缓清洁 -->
      <div class="herb-category animate-on-scroll">
        <div class="herb-img"><img src="{{ 'slide4_img13_16.png' | asset_url }}" alt="{{ 'ingredients.group3_name' | t }}" loading="lazy"></div>
        <h3 class="category-title">{{ 'ingredients.group3_icon_title' | t }}</h3>
        <div class="herb-tags">
          <span class="herb-tag">{{ 'ingredients.herb_aiye' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_kushen' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_shechuangzi' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_difuzi' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_bohe' | t }}</span>
        </div>
      </div>

      <!-- 活络疏通 -->
      <div class="herb-category animate-on-scroll">
        <div class="herb-img"><img src="{{ 'slide4_img14_17.png' | asset_url }}" alt="{{ 'ingredients.group4_name' | t }}" loading="lazy"></div>
        <h3 class="category-title">{{ 'ingredients.group4_icon_title' | t }}</h3>
        <div class="herb-tags">
          <span class="herb-tag">{{ 'ingredients.herb_danshen' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_chuanxiong' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_tougucao' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_gusubu' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_sangye' | t }}</span>
          <span class="herb-tag">{{ 'ingredients.herb_yupi' | t }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}{"name":"Ingredients","settings":[],"presets":[{"name":"Ingredients"}]}{% endschema %}
