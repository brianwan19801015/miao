<section class="testimonials" id="testimonials">
  <div class="container">
    <h2 class="section-title">{{ 'testimonials.title' | t }}</h2>
    <p class="section-desc">{{ 'testimonials.subtitle' | t }}</p>
    <div class="testimonials-grid">
      <div class="testimonial-card">
        <div class="stars">★★★★★</div>
        <p class="testimonial-text">{{ 'testimonials.item1_text_full' | t }}</p>
        <div class="testimonial-author">
          <div class="author-avatar"><i class="fas fa-user-circle"></i></div>
          <div>
            <strong>{{ 'testimonials.item1_author' | t }}</strong>
            <span>{{ 'testimonials.item1_tag' | t }}</span>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <div class="stars">★★★★★</div>
        <p class="testimonial-text">{{ 'testimonials.item2_text_full' | t }}</p>
        <div class="testimonial-author">
          <div class="author-avatar"><i class="fas fa-user-circle"></i></div>
          <div>
            <strong>{{ 'testimonials.item2_author' | t }}</strong>
            <span>{{ 'testimonials.item2_tag' | t }}</span>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <div class="stars">★★★★☆</div>
        <p class="testimonial-text">{{ 'testimonials.item3_text_full' | t }}</p>
        <div class="testimonial-author">
          <div class="author-avatar"><i class="fas fa-user-circle"></i></div>
          <div>
            <strong>{{ 'testimonials.item3_author' | t }}</strong>
            <span>{{ 'testimonials.item3_tag' | t }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Testimonials",
  "settings": [],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}