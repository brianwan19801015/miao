<section class="product-intro" id="product">
  <div class="container">
    <!-- Hero Story Block: Inspired by Viori's "Story Behind the Bar" -->
    <div class="product-intro-grid">
      <div class="product-intro-image">
        <img src="{{ 'slide3_img1_8.png' | asset_url }}" alt="{{ 'general.hero_title' | t }}" loading="lazy">
      </div>
      <div class="product-intro-text">
        <div class="intro-block">
          <span class="badge">{{ 'product_intro.positioning_badge' | t }}</span>
          <h2>{{ 'product_intro.story_title' | t }}</h2>
          <p>{{ 'product_intro.story_desc' | t | newline_to_br }}</p>
        </div>
        
        <div class="intro-block">
          <p class="positioning-desc">{{ 'product_intro.positioning_desc' | t }}</p>
        </div>
        
        <ul class="product-features">
          <li><i class="fas fa-check-circle"></i>{{ 'product_intro.feature1' | t }}</li>
          <li><i class="fas fa-check-circle"></i>{{ 'product_intro.feature2' | t }}</li>
          <li><i class="fas fa-check-circle"></i>{{ 'product_intro.feature3' | t }}</li>
          <li><i class="fas fa-check-circle"></i>{{ 'product_intro.feature4' | t }}</li>
        </ul>
        
        <a href="#contact" class="btn btn-primary">{{ 'general.consult' | t }}</a>
      </div>
    </div>

    <!-- Heritage Section: From Miao Mountains to Global Markets -->
    <div class="heritage-section">
      <div class="heritage-content">
        <div class="heritage-icon">🌿</div>
        <h3>{{ 'product_intro.heritage_title' | t }}</h3>
        <p class="heritage-subtitle">{{ 'product_intro.heritage_subtitle' | t }}</p>
        <p class="heritage-desc">{{ 'product_intro.heritage_desc' | t }}</p>
        <div class="heritage-tags">
          <span class="heritage-tag"><i class="fas fa-leaf"></i>{{ 'product_intro.heritage_item1' | t }}</span>
          <span class="heritage-tag"><i class="fas fa-snowflake"></i>{{ 'product_intro.heritage_item2' | t }}</span>
          <span class="heritage-tag"><i class="fas fa-shield-alt"></i>{{ 'product_intro.heritage_item3' | t }}</span>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product Intro",
  "settings": [],
  "presets": [{ "name": "Product Intro" }]
}
{% endschema %}
