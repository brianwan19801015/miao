<section class="product-intro" id="product">
  <div class="container">
    <!-- 主体：图+文左右布局 -->
    <div class="product-intro-grid">
      <div class="product-intro-image">
        <img src="{{ 'slide3_img1_8.png' | asset_url }}" alt="苗本芳养发皂">
      </div>
      <div class="product-intro-text">
        <div class="intro-block">
          <span class="badge">BRAND STORY</span>
          <h2>苗本芳养发皂 — 来自苗家的头皮养护智慧</h2>
          <p>源于古老的苗族护发古方，结合现代低温冷制工艺，甄选十余种天然草本植萃。拒绝化学添加，只为还原植物本身的能量，带来最纯粹的头皮养护体验。</p>
        </div>
        
        <div class="intro-block">
          <span class="badge">PRODUCT POSITIONING</span>
          <h2>产品定位 · POSITIONING</h2>
          <p>这不是一块普通的香皂，而是一款集"清洁+养护+调理"于一体的头皮健康皂。专为现代人敏感、脆弱、出油的头皮环境研发，洗养同步，重塑头皮微生态。</p>
        </div>
        
        <ul class="product-features">
          <li><i class="fas fa-check-circle"></i> 18味草本复配</li>
          <li><i class="fas fa-check-circle"></i> 45天低温冷制</li>
          <li><i class="fas fa-check-circle"></i> 温和净养，敏感头皮可用</li>
          <li><i class="fas fa-check-circle"></i> 一块皂覆盖四大头皮诉求</li>
        </ul>
        
        <a href="#contact" class="btn btn-primary">咨询购买</a>
      </div>
    </div>

    <!-- 底部：苗家智慧传承 -->
    <div class="heritage-section">
      <div class="heritage-content">
        <div class="heritage-icon">🌿</div>
        <h3>苗家智慧传承</h3>
        <p class="heritage-subtitle">苗家古方，现代科技赋能</p>
        <p class="heritage-desc">苗本芳养发皂融合苗族千年护发智慧与现代低温冷制工艺，精选18味草本科学配伍，从根源调理头皮微生态。</p>
        <div class="heritage-tags">
          <span class="heritage-tag"><i class="fas fa-leaf"></i> 18味苗家草本 · 君臣佐使科学配伍</span>
          <span class="heritage-tag"><i class="fas fa-snowflake"></i> 45天低温冷制 · 锁住活性成分</span>
          <span class="heritage-tag"><i class="fas fa-shield-alt"></i> 5大0添加 · 温和安全不刺激</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.product-intro {
  padding: 80px 0;
  background: #fff;
}
.product-intro-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  max-width: 1100px;
  margin: 0 auto 60px;
}
.product-intro-image img {
  width: 100%;
  max-width: 480px;
  border-radius: 24px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.1);
  display: block;
  margin: 0 auto;
}
.intro-block { margin-bottom: 28px; }
.intro-block .badge { margin-bottom: 8px; }
.intro-block h2 {
  font-size: 20px;
  font-weight: 700;
  color: #2d4a2a;
  margin: 0 0 10px;
  line-height: 1.3;
}
.intro-block p {
  font-size: 14px;
  color: #555;
  line-height: 1.8;
  margin: 0;
}
.product-features {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
}
.product-features li {
  padding: 8px 0;
  font-size: 15px;
  color: #333;
}
.product-features i {
  color: #4a7c3f;
  margin-right: 10px;
}

/* 苗家智慧传承 */
.heritage-section {
  background: linear-gradient(135deg, #f0f5eb 0%, #e8f0e0 100%);
  border-radius: 24px;
  padding: 48px 40px;
  text-align: center;
  max-width: 900px;
  margin: 0 auto;
}
.heritage-icon {
  font-size: 48px;
  margin-bottom: 12px;
}
.heritage-content h3 {
  font-size: 26px;
  font-weight: 700;
  color: #2d4a2a;
  margin: 0 0 4px;
}
.heritage-subtitle {
  font-size: 15px;
  color: #4a7c3f;
  font-weight: 600;
  margin: 0 0 16px;
}
.heritage-desc {
  font-size: 14px;
  color: #555;
  line-height: 1.8;
  max-width: 640px;
  margin: 0 auto 24px;
}
.heritage-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}
.heritage-tag {
  background: #fff;
  color: #2d4a2a;
  padding: 10px 20px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  transition: transform 0.3s;
}
.heritage-tag:hover {
  transform: translateY(-2px);
}
.heritage-tag i {
  color: #4a7c3f;
  margin-right: 6px;
}

@media (max-width: 768px) {
  .product-intro-grid { grid-template-columns: 1fr; gap: 32px; }
  .heritage-section { padding: 32px 20px; }
  .heritage-tags { flex-direction: column; align-items: center; }
  .heritage-tag { width: 100%; max-width: 360px; text-align: center; }
}
</style>

