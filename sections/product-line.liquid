<section class="product-line" id="product-line">
  <div class="container">
    <h2 class="section-title">{{ 'product_line.title' | t }}</h2>
    <p class="section-desc">{{ 'product_line.subtitle' | t }}</p>
    <div class="product-gifts">
      <div class="gift-item">
        <img class="only-mobile" src="{{ 'slide10_img0_33.png' | asset_url }}" alt="{{ 'general.hero_title' | t }}" loading="lazy">
        <img class="only-desktop" src="{{ 'slide3_product.png' | asset_url }}" alt="{{ 'general.hero_title' | t }}" loading="lazy">
        <div class="gift-info">
          <h3>{{ 'product_line.single_name' | t }}</h3>
          <p>{{ 'product_line.single_desc' | t }}</p>
          <a href="/products/test" class="btn btn-primary" style="margin-top:8px; display:inline-block;">Buy Now →</a>
        </div>
      </div>
      <div class="gift-item">
        <div class="gift-info-only">
          <h3>{{ 'product_line.more_title' | t }}</h3>
          <p>{{ 'product_line.more_desc' | t }}</p>
          <ul>
            <li>{{ 'product_line.more_item1' | t }}</li>
            <li>{{ 'product_line.more_item2' | t }}</li>
            <li>{{ 'product_line.more_item3' | t }}</li>
          </ul>
          <a href="#contact" class="btn btn-primary" style="margin-top:12px;">{{ 'product_line.consult_btn' | t }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product Line",
  "settings": [],
  "presets": [{ "name": "Product Line" }]
}
{% endschema %}