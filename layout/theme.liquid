<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Title & Description -->
    <title>{% if template == 'page' and page.title != blank %}{{ page.title }} - 苗本芳{% else %}苗本芳 - 草本冷制皂 · 供应链源头工厂 | 全球合作伙伴招募{% endif %}</title>
    <meta name="description" content="{% if template == 'page' and page.meta_description != blank %}{{ page.meta_description }}{% else %}苗本芳 - 草本冷制皂供应链源头工厂。18味草本配方，45天低温冷制，5大0添加。OEM/ODM定制，面向全球招募经销商与进口商合作伙伴。{% endif %}">
    <meta name="keywords" content="苗本芳,冷制皂,草本皂,OEM,ODM,手工皂代工,肥皂供应链,天然皂出口">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "苗本芳养发皂",
      "description": "苗本芳 - 草本冷制皂供应链源头工厂。18味草本配方，45天低温冷制，5大0添加。OEM/ODM定制，面向全球招募经销商与进口商合作伙伴。",
      "brand": {
        "@type": "Brand",
        "name": "苗本芳"
      },
      "category": "头皮护理",
      "material": "18味草本植萃"
    }
    </script>
    
    <!-- BreadcrumbList Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首页", "item": "{{ shop.url }}" },
        { "@type": "ListItem", "position": 2, "name": "苗本芳养发皂", "item": "{{ shop.url }}" }
      ]
    }
    </script>

    {{ content_for_header }}
    {{ 'style.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

{% section 'header' %}
{{ content_for_layout }}
{% section 'trust-bar' %}
{% section 'footer' %}

<a href="#" class="back-to-top" id="backToTop"><i class="fas fa-chevron-up"></i></a>
<div class="toast" id="toast"></div>

{{ 'main.js' | asset_url | script_tag }}
</body>
</html>
