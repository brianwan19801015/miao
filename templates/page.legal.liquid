<section class="legal-page" style="padding: 80px 0;">
  <div class="container" style="max-width: 800px; margin: 0 auto;">
    {% if page.content != blank %}
      {{ page.content }}
    {% else %}
      <h1 style="font-size: 28px; margin-bottom: 30px;">{{ page.title }}</h1>
      <div class="legal-content">
        <p style="color: #666; line-height: 1.8;">内容加载中，请稍后再试。</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .legal-page h1 { font-size: 28px; margin-bottom: 24px; }
  .legal-page h2 { font-size: 20px; margin: 28px 0 12px; }
  .legal-page h3 { font-size: 16px; margin: 20px 0 10px; }
  .legal-page p, .legal-page li { line-height: 1.8; color: #555; margin-bottom: 8px; }
  .legal-page ul { padding-left: 20px; }
  .legal-page a { color: var(--accent); }
</style>

{% schema %}
{
  "name": "Legal Page",
  "settings": [],
  "presets": [{ "name": "Legal Page" }]
}
{% endschema %}
